# AWS runtime identifiers only. Do not put credentials or secret values here.
#
# The application does not automatically load this file. Export these values in
# the shell, or install a reviewed copy as the systemd EnvironmentFile.
# EC2 must obtain AWS credentials from its Instance Profile.

AWS_REGION=ap-southeast-1
SOC_DEPLOYMENT_TARGET=aws
ALLOW_LEGACY_INGEST=false
SECRETS_CACHE_TTL_SECONDS=300
SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/<aws-account-id>/socai-dev-normalized-zeek-events-queue
SQS_VISIBILITY_TIMEOUT_SECONDS=120
SQS_VISIBILITY_HEARTBEAT_SECONDS=30
RDS_SECRET_ID=socai/dev/rds/app
RDS_CONNECT_TIMEOUT_SECONDS=10
RDS_APPLICATION_NAME=hybrid-soc
S3_DATA_BUCKET=socai-dev-<aws-account-id>-ap-southeast-1-data
S3_KMS_KEY_ID=arn:aws:kms:ap-southeast-1:<aws-account-id>:key/<key-id>

# MODEL_ARTIFACT_ROOT is a bundle container with ACTIVE, versions/ and .staging/.
# Upload manifest.json at MODEL_S3_PREFIX and pin the SHA-256 of its exact bytes.
# Each manifest artifact path remains repository-relative (for example Dataset/...).
MODEL_S3_PREFIX=models/runtime-bundle/v1
MODEL_ARTIFACT_ROOT=/var/lib/socai/model-bundle
MODEL_BUNDLE_MANIFEST_SHA256=<64-character-lowercase-sha256-of-manifest>

# The secret JSON contains {"hmac_secret":"..."}. Do not place the value here.
INGEST_HMAC_REQUIRED=true
INGEST_HMAC_SECRET_ID=socai/dev/ingest/hmac
INGEST_HMAC_SECRET_KEY=hmac_secret
INGEST_HMAC_MAX_SKEW_SECONDS=300
INGEST_MAX_BODY_BYTES=240000

# Each API instance polls shared RDS results and fans them out to its own WS clients.
RDS_ALERT_SYNC_ENABLED=true
RDS_ALERT_SYNC_INTERVAL_SECONDS=2
RDS_ALERT_SYNC_BATCH_SIZE=200
CORS_ALLOWED_ORIGINS=https://soc.example.com

# Valid values: mock, replay, unavailable, real.
# Use real only when the reviewed model artifacts are present on the instance.
AWS_REQUIRE_REAL_MODELS=true
AI1_PREDICTOR_MODE=real
AI2A_PREDICTOR_MODE=real
AI2B_PREDICTOR_MODE=real
