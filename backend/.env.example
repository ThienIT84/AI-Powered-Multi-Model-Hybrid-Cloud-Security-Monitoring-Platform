# AWS
AWS_REGION=ap-southeast-1

# S3 evidence bucket
S3_EVIDENCE_BUCKET=socai-dev-data-913626885845

# SQS queue
SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/913626885845/<queue-name>

# For FIFO queue only. Ignored for standard queue.
SQS_MESSAGE_GROUP_ID=socai-events

# Processing mode:
# sync  = API xử lý trực tiếp như cũ
# async = API gửi event vào SQS, worker xử lý và lưu S3
PROCESSING_MODE=async

# AI model mode
AI1_PREDICTOR_MODE=mock
AI2A_PREDICTOR_MODE=mock
AI2B_PREDICTOR_MODE=mock

# Worker tuning
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=60
WORKER_ERROR_SLEEP_SECONDS=5
WORKER_LOG_LEVEL=INFO