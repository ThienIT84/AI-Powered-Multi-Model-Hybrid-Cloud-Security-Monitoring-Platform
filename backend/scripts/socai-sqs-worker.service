[Unit]
Description=SOC AI SQS Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/soc-mvp/current
EnvironmentFile=-/home/ec2-user/soc-mvp/current/.env
Environment="PYTHONPATH=/home/ec2-user/soc-mvp/current"
ExecStart=/home/ec2-user/miniconda3/envs/interior_ai/bin/python -u /home/ec2-user/soc-mvp/current/scripts/sqs_worker.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=socai-sqs-worker

[Install]
WantedBy=multi-user.target