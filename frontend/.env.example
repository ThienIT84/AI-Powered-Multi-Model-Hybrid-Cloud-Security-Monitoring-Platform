# Deployment target: local uses the absolute localhost fallbacks below; aws uses
# the current CloudFront origin and rejects cross-origin API/WebSocket URLs.
VITE_DEPLOYMENT_ENV=local

# Valid values: live or replay. Both modes read exclusively from the backend.
VITE_DATA_MODE=live
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/alerts

# Used only by the local Vite proxy for /api, /ws, and /ingest. This variable is
# intentionally not prefixed with VITE_ so it is not exposed in the browser.
DEV_BACKEND_ORIGIN=http://127.0.0.1:8000

# AWS/CloudFront builds should set VITE_DEPLOYMENT_ENV=aws and omit
# VITE_API_BASE_URL/VITE_WS_URL (or set them to the same CloudFront origin).
